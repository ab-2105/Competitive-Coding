#include <vector>
#include <string>
#include <unordered_set>

class Solution {
public:
    std::vector<std::vector<std::string>> solveNQueens(int n) {
        std::vector<std::vector<std::string>> result;
        std::vector<std::string> board(n, std::string(n, '.'));

        std::unordered_set<int> cols;
        std::unordered_set<int> posDiag;
        std::unordered_set<int> negDiag;

        backtrack(0, n, board, cols, posDiag, negDiag, result);
        return result;
    }

private:
    void backtrack(int row, int n, std::vector<std::string>& board,
                   std::unordered_set<int>& cols,
                   std::unordered_set<int>& posDiag,
                   std::unordered_set<int>& negDiag,
                   std::vector<std::vector<std::string>>& result) {
        if (row == n) {
            result.push_back(board);
            return;
        }

        for (int col = 0; col < n; col++) {
            int pDiag = row + col;
            int nDiag = row - col;

            if (cols.count(col) || posDiag.count(pDiag) || negDiag.count(nDiag)) {
                continue;
            }

            board[row][col] = 'Q';
            cols.insert(col);
            posDiag.insert(pDiag);
            negDiag.insert(nDiag);

            backtrack(row + 1, n, board, cols, posDiag, negDiag, result);

            board[row][col] = '.';
            cols.erase(col);
            posDiag.erase(pDiag);
            negDiag.erase(nDiag);
        }
    }
};
