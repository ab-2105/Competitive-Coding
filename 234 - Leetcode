intuition

1. Find Middle: Move fast by 2 and slow by 1; slow stops at the midpoint.

2. Reverse Half: Reverse all pointers from slow to the end in-place.

3. Compare: Walk from head and reversed tail simultaneously; match all values.

4. Return: true if all match, false if any differ.

Time Complexity: O(n)
Space Complexity: O(1)


CODE :- 
class Solution {
public:
    bool isPalindrome(ListNode* head) {
        if (!head || !head->next) return true;

        ListNode* slow = head;
        ListNode* fast = head;
        while (fast && fast->next) {
            slow = slow->next;
            fast = fast->next->next;
        }

        ListNode* prev = nullptr;
        ListNode* curr = slow;
        while (curr) {
            ListNode* nextNode = curr->next;
            curr->next = prev;
            prev = curr;
            curr = nextNode;
        }

        ListNode* left = head;
        ListNode* right = prev; 
        bool isPalin = true;

        while (right) {
            if (left->val != right->val) {
                isPalin = false;
                break;
            }
            left = left->next;
            right = right->next;
        }

        return isPalin;
    }
};
