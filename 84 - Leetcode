Intuition :- 

Treat every bar as the smallest height of a rectangle. Find the nearest smaller bar on the left and right, then calculate the maximum width that bar can extend. The largest area among all bars is the answer.

Approach :- 

1. Compute Previous Smaller Element (PSE) for each bar and store it in lessFromLeft.

2. Compute Next Smaller Element (NSE) for each bar and store it in lessFromRight.

3. For every bar:

    width = lessFromRight[i] - lessFromLeft[i] - 1
    
    area = heights[i] × width

4. Return the maximum area.

Time Complexity: O(n)

Space Complexity: O(n)


code :- 

#include <vector>
#include <algorithm>

class Solution {
public:
    int largestRectangleArea(std::vector<int>& heights) {
        if (heights.empty()) return 0;
        
        int n = heights.size();
        std::vector<int> lessFromLeft(n);
        std::vector<int> lessFromRight(n);
      
        lessFromLeft[0] = -1; 
        for (int i = 1; i < n; ++i) {
            int p = i - 1;
            while (p >= 0 && heights[p] >= heights[i]) {
                p = lessFromLeft[p];
            }
            lessFromLeft[i] = p;
        }
        lessFromRight[n - 1] = n;
        for (int i = n - 2; i >= 0; --i) {
            int p = i + 1;
            while (p < n && heights[p] >= heights[i]) {
                p = lessFromRight[p];
            }
            lessFromRight[i] = p;
        }
        
        int maxArea = 0;
        for (int i = 0; i < n; ++i) {
            int width = lessFromRight[i] - lessFromLeft[i] - 1;
            maxArea = std::max(maxArea, heights[i] * width);
        }
        
        return maxArea;
    }
};
